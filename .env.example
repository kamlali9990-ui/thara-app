# Supabase Configuration
# Get these from your Supabase project dashboard > Settings > API
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Cloudinary Configuration (for signed upload signature via Supabase Edge Function)
# Get these from https://console.cloudinary.com > Settings > API Keys
CLOUDINARY_CLOUD_NAME=dvnhgvdd1
CLOUDINARY_API_KEY=YOUR_CLOUDINARY_API_KEY
CLOUDINARY_API_SECRET=YOUR_CLOUDINARY_API_SECRET

# Default password for new staff accounts (change this!)
VITE_STAFF_DEFAULT_PASSWORD=CHANGE_ME

# Sentry Error Tracking (optional)
# Create account at https://sentry.io and get your DSN from Projects > [project] > Settings > Client Keys
VITE_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0


# For Supabase CLI (optional - needed for db operations)
# Create token at: https://supabase.com/dashboard/account/tokens
# Then save it in your password manager, NOT in this file:
#   $env:SUPABASE_ACCESS_TOKEN="sbp_..."
# Or on Mac/Linux:
#   export SUPABASE_ACCESS_TOKEN="sbp_..."
